# Local development only: Docker Compose binds PostgreSQL to loopback and uses trust auth.
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/resume_ok

# 邮件发送配置（本地默认连接 Mailpit 1025 端口；生产环境可填 QQ邮箱/163/腾讯企业邮 SMTP 465 端口）
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ResumeOK <no-reply@resume-ok.local>
NEXT_PUBLIC_MAILBOX_URL=http://localhost:8025

# Google sign-in (optional). Configure real credentials only in a local editor or hosting secret settings.
# APP_URL must be the canonical site origin; do not include a path.
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 支付网关配置（sandbox 为沙盒测试模式；接入虎皮椒/PayJS/易支付时改为 gateway 并填写下方密钥）
PAYMENT_PROVIDER_MODE=sandbox
PAYMENT_GATEWAY_URL=
PAYMENT_APP_ID=
PAYMENT_APP_SECRET=
